<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/WeatherCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Weather Symbol / Image -->
        <ImageView
            android:id="@+id/weatherIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Weather Symbol"
            android:src="@drawable/ic_weather_sunny" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- City and Time Text Field using Downloadable Font & Custom Style -->
            <TextView
                android:id="@+id/timeText"
                style="@style/WeatherItemTimeStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Weather Condition and Wind Speed using Downloadable Font & Custom Style -->
            <TextView
                android:id="@+id/windText"
                style="@style/WeatherItemWindStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Temperature Text Field using Downloadable Font & Custom Style -->
        <TextView
            android:id="@+id/tempText"
            style="@style/WeatherItemTempStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
